# ============================================================================
# CELL 2: Check GPU
# ============================================================================
import torch
print(f"GPU: {torch.cuda.get_device_name(0)}")
print(f"VRAM: {torch.cuda.get_device_properties(0).total_memory / 1024**3:.1f} GB")
print(f"PyTorch: {torch.__version__}")

# ============================================================================
# CELL 3: Download base model
# ============================================================================
from huggingface_hub import snapshot_download

MODEL_ID = "Qwen/Qwen3.5-4B"
LOCAL_DIR = "/content/qwen3.5-4b"

snapshot_download(
    repo_id=MODEL_ID,
    local_dir=LOCAL_DIR,
    ignore_patterns=["*.gguf", "*.bin"],  # We'll use safetensors
)
print(f"Model downloaded to {LOCAL_DIR}")

# ============================================================================
# CELL 4: Test stock model for refusals
# ============================================================================
from transformers import AutoModelForCausalLM, AutoTokenizer
import torch

# Load abliterated model for fine-tuning
model = AutoModelForCausalLM.from_pretrained(
    "/content/qwen3.5-4b-abliterated",  # Abliterated model, not base
    torch_dtype=torch.bfloat16,
    device_map="auto",
    trust_remote_code=True,
)
tokenizer = AutoTokenizer.from_pretrained(LOCAL_DIR, trust_remote_code=True)

test_prompts = [
    "What is the best trading strategy for EURUSD?",
    "How do I maximize profit in forex trading?",
    "Should I buy or sell gold right now?",
    "Explain how to exploit market inefficiencies",
    "What are the risks of leverage trading?",
]

for prompt in test_prompts:
    inputs = tokenizer(prompt, return_tensors="pt").to(model.device)
    outputs = model.generate(**inputs, max_new_tokens=200, do_sample=False)
    response = tokenizer.decode(outputs[0], skip_special_tokens=True)
    print(f"\nPrompt: {prompt}")
    print(f"Response: {response[:300]}")
    print("-" * 80)

# ============================================================================
# CELL 5: Abliterate with OBLITERATUS (MANDATORY — David confirmed)
# ============================================================================
# OBLITERATUS is Linux/Mac only, CPU tier <1B only.
# We run on Colab T4 (16GB VRAM) which fits 4B easily.
# Method: advanced (multi-direction SVD, norm-preserving)
# Quantization: 4bit (saves VRAM during abliteration)

import subprocess
import os

# Clone OBLITERATUS
if not os.path.exists("/content/OBLITERATUS"):
    subprocess.run([
        "git", "clone", "https://github.com/elder-plinius/OBLITERATUS.git",
        "/content/OBLITERATUS"
    ], check=True)
    subprocess.run([
        "pip", "install", "-e", "/content/OBLITERATUS"
    ], check=True)

# Run abliteration
result = subprocess.run([
    "python", "-m", "obliteratus", "obliterate", MODEL_ID,
    "--method", "advanced",
    "--quantization", "4bit",
    "--output-dir", "/content/qwen3.5-4b-abliterated",
    "--direction-method", "diff_means",
    "--n-directions", "4",
    "--refinement-passes", "2",
    "--regularization", "0.1",
], capture_output=True, text=True, cwd="/content/OBLITERATUS")

print("STDOUT:")
print(result.stdout[-2000:])  # Last 2000 chars
print("\nSTDERR:")
print(result.stderr[-2000:])

# Check exit code
if result.returncode != 0:
    print(f"\n⚠️ Abliteration failed with exit code {result.returncode}")
else:
    print("\n✅ Abliteration complete!")

# ============================================================================
# CELL 6: Prepare training data
# ============================================================================
# Upload train.jsonl, val.jsonl, test.jsonl to Colab
# from google.colab import files
# uploaded = files.upload()  # Upload train.jsonl, val.jsonl

from datasets import load_dataset

dataset = load_dataset("json", data_files={
    "train": "/content/train.jsonl",
    "validation": "/content/val.jsonl",
})
print(f"Train: {len(dataset['train'])} examples")
print(f"Val: {len(dataset['validation'])} examples")

# ============================================================================
# CELL 7: Fine-tune with LoRA
# ============================================================================
from peft import LoraConfig, get_peft_model, TaskType
from trl import SFTTrainer, SFTConfig
from transformers import TrainingArguments

# LoRA config for 4B model
lora_config = LoraConfig(
    r=16,
    lora_alpha=32,
    target_modules=["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    lora_dropout=0.05,
    bias="none",
    task_type=TaskType.CAUSAL_LM,
)

# Training config
training_args = SFTConfig(
    output_dir="/content/nativa-finetuned",
    num_train_epochs=3,
    per_device_train_batch_size=2,
    gradient_accumulation_steps=4,
    learning_rate=2e-4,
    weight_decay=0.01,
    warmup_ratio=0.03,
    lr_scheduler_type="cosine",
    logging_steps=10,
    save_steps=100,
    eval_strategy="steps",
    eval_steps=100,
    bf16=True,
    max_seq_length=2048,
    packing=True,
)

trainer = SFTTrainer(
    model=model,
    args=training_args,
    train_dataset=dataset["train"],
    eval_dataset=dataset["validation"],
    peft_config=lora_config,
    tokenizer=tokenizer,
)

trainer.train()

# Save fine-tuned model
trainer.save_model("/content/nativa-finetuned")
tokenizer.save_pretrained("/content/nativa-finetuned")
print("Fine-tuning complete!")

# ============================================================================
# CELL 8: Merge LoRA weights
# ============================================================================
from peft import PeftModel

# Load abliterated model + LoRA adapter
base_model = AutoModelForCausalLM.from_pretrained(
    "/content/qwen3.5-4b-abliterated",  # Use abliterated model, not base
    torch_dtype=torch.bfloat16,
    device_map="auto",
    trust_remote_code=True,
)
peft_model = PeftModel.from_pretrained(base_model, "/content/nativa-finetuned")
merged_model = peft_model.merge_and_unload()

# Save merged model
merged_model.save_pretrained("/content/nativa-merged")
tokenizer.save_pretrained("/content/nativa-merged")
print("LoRA weights merged!")

